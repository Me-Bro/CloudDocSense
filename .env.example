# Database
DATABASE_URL=postgresql+asyncpg://docsense:docsense@postgres:5432/docsense
DATABASE_URL_SYNC=postgresql://docsense:docsense@postgres:5432/docsense

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Object Storage (MinIO / S3)
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=docsense-docs

# AI APIs
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key

# OpenRouter (free-tier generation + vision) — get key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GENERATION_MODEL=meta-llama/llama-3.3-70b-instruct:free
VISION_MODEL=meta-llama/llama-3.2-11b-vision-instruct:free

# Auth
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# App
APP_ENV=development
LOG_LEVEL=INFO
# Embeddings: "local" (fastembed, free/offline) or "openai"
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
RETRIEVAL_TOP_K=5
RETRIEVAL_CONFIDENCE_THRESHOLD=0.3
